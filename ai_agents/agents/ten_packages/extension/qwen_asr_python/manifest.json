{
  "type": "extension",
  "name": "qwen_asr_python",
  "version": "0.1.0",
  "dependencies": [
    {
      "type": "system",
      "name": "ten_runtime_python",
      "version": "0.11"
    },
    {
      "type": "system",
      "name": "ten_ai_base",
      "version": "0.7"
    }
  ],
  "api": {
    "interface": [
      {
        "import_uri": "../../system/ten_ai_base/api/asr-interface.json"
      }
    ],
    "property": {
      "properties": {
        "dump": {"type": "bool"},
        "dump_path": {"type": "string"},
        "finalize_timeout_ms": {"type": "int32"},
        "connect_timeout_s": {"type": "int32"},
        "reconnect_max_attempts": {"type": "int32"},
        "params": {
          "type": "object",
          "properties": {
            "api_key": {"type": "string"},
            "url": {"type": "string"},
            "model": {"type": "string"},
            "format": {"type": "string"},
            "sample_rate": {"type": "int32"},
            "vad_model": {"type": "string"},
            "max_sentence_silence": {"type": "int32"},
            "keep_dialect": {"type": "bool"},
            "heartbeat": {"type": "bool"},
            "language_hints": {"type": "array", "items": {"type": "string"}},
            "vocabulary_id": {"type": "string"},
            "vocabulary": {"type": "object", "properties": {}},
            "context": {"type": "array", "items": {"type": "object", "properties": {}}}
          }
        }
      }
    }
  },
  "package": {
    "include": [
      "manifest.json",
      "property.json",
      "**.py",
      "pyproject.toml",
      "requirements.txt",
      "README.md",
      "docs/**"
    ]
  }
}
