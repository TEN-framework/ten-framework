{
  "type": "extension",
  "name": "elevenlabs_asr_python",
  "version": "0.3.1",
  "dependencies": [
    {
      "type": "system",
      "name": "ten_runtime_python",
      "version": "0.11"
    },
    {
      "type": "system",
      "name": "ten_ai_base",
      "version": "0.7"
    }
  ],
  "api": {
    "interface": [
      {
        "import_uri": "../../system/ten_ai_base/api/asr-interface.json"
      }
    ],
    "property": {
      "properties": {
        "dump": {
          "type": "bool"
        },
        "dump_path": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string"
            },
            "token": {
              "type": "string"
            },
            "ws_url": {
              "type": "string"
            },
            "sample_rate": {
              "type": "int64"
            },
            "audio_format": {
              "type": "string"
            },
            "model_id": {
              "type": "string"
            },
            "language_code": {
              "type": "string"
            },
            "include_timestamps": {
              "type": "bool"
            },
            "include_language_detection": {
              "type": "bool"
            },
            "secondary_languages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "commit_strategy": {
              "type": "string"
            },
            "vad_threshold": {
              "type": "float64"
            },
            "vad_silence_threshold_secs": {
              "type": "float64"
            },
            "min_speech_duration_ms": {
              "type": "int64"
            },
            "min_silence_duration_ms": {
              "type": "int64"
            },
            "keyterms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "no_verbatim": {
              "type": "bool"
            },
            "filter_background_audio": {
              "type": "bool"
            },
            "keepalive_interval_ms": {
              "type": "int64"
            },
            "enable_logging": {
              "type": "bool"
            },
            "connect_timeout": {
              "type": "int64"
            },
            "finalize_timeout": {
              "type": "int64"
            }
          }
        }
      }
    }
  },
  "package": {
    "include": [
      "manifest.json",
      "property.json",
      "**.py",
      "pyproject.toml",
      "requirements.txt",
      "docs/**"
    ]
  }
}
