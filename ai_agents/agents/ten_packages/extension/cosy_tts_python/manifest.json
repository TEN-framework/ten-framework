{
  "type": "extension",
  "name": "cosy_tts_python",
  "version": "0.4.4",
  "dependencies": [
    {
      "type": "system",
      "name": "ten_runtime_python",
      "version": "0.11"
    },
    {
      "type": "system",
      "name": "ten_ai_base",
      "version": "0.7"
    }
  ],
  "package": {
    "include": [
      "manifest.json",
      "property.json",
      "BUILD.gn",
      "**.tent",
      "**.py",
      "README.md",
      "pyproject.toml",
      "requirements.txt"
    ]
  },
  "api": {
    "interface": [
      {
        "import_uri": "../../system/ten_ai_base/api/tts-interface.json"
      }
    ],
    "property": {
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string"
            },
            "cancel_timeout_ms": {
              "type": "int64"
            },
            "first_audio_timeout_ms": {
              "type": "int64"
            },
            "headers": {
              "type": "object",
              "properties": {}
            },
            "input_idle_timeout_ms": {
              "type": "int64"
            },
            "model": {
              "type": "string"
            },
            "pool_size": {
              "type": "int64"
            },
            "pool_wait_timeout_ms": {
              "type": "int64"
            },
            "sample_rate": {
              "type": "int64"
            },
            "task_timeout_ms": {
              "type": "int64"
            },
            "voice": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "workspace_id": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
